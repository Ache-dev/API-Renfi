# Configuración del servidor
PORT=3000
NODE_ENV=development

# Configuración de Base de Datos (PostgreSQL / Supabase)
# Opción A: Cadena de conexión completa provista por Supabase (recomendada)
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Opción B: Credenciales individuales (útil para desarrollo local o conexión directa)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=postgres
DB_SSL=false

# Seguridad y Autenticación JWT
JWT_SECRET=renfi_jwt_super_secret_key_2025_safe_token
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=*
