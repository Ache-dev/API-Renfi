# Servidor
PORT=3000
NODE_ENV=development

# Azure Database for PostgreSQL (rol renfi_app: solo puede ejecutar los sp_* de db/azure/schema.sql)
# En producción la conexión usa TLS verificado: añade ?sslmode=require si tu cliente lo necesita.
DATABASE_URL=postgresql://renfi_app:<contraseña>@<servidor>.postgres.database.azure.com:5432/renfi

# Conexiones a la base por instancia de la API (el rol renfi_app admite 30 en total: instancias x DB_POOL_MAX <= 30)
DB_POOL_MAX=10

# Proxies de confianza delante de la API: 1 en Azure App Service (por defecto 1 en producción, 0 en local).
# Sin esto el límite de peticiones por IP vería a todos los usuarios como uno solo.
TRUST_PROXY=

# Azure Blob Storage (contenedor público de imágenes de fincas)
# URL de la cuenta, SIN el contenedor. En local con Azurite: http://127.0.0.1:10000/devstoreaccount1
AZURE_STORAGE_ACCOUNT_URL=https://<cuenta>.blob.core.windows.net
AZURE_STORAGE_CONTAINER=fincas-imagenes
# SOLO desarrollo (Azurite o clave de la cuenta). En Azure déjala vacía y usa identidad administrada.
AZURE_STORAGE_CONNECTION_STRING=

# Seguridad y Autenticación JWT
JWT_SECRET=
JWT_EXPIRES_IN=1d

# CORS
CORS_ORIGIN=*
