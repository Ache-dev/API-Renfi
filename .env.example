# Servidor
PORT=3000
NODE_ENV=development

# Supabase (la API consume la base de datos por su API REST / PostgREST)
# Project Settings -> API en el panel de Supabase.
# También se aceptan NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (como en Renfi-ExpoGO).
SUPABASE_URL=https://<project-ref>.supabase.co
# Clave publishable (sb_publishable_...) o, recomendado en el backend, la secret (sb_secret_...).
# La secret NUNCA debe ir al frontend ni a git.
SUPABASE_KEY=

# Seguridad y Autenticación JWT
JWT_SECRET=
JWT_EXPIRES_IN=1d

# CORS
CORS_ORIGIN=*
